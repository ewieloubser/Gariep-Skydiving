# ---- Supabase (Project Settings -> API) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side ONLY, never in the browser

# ---- Yoco (Developer / API keys) ----
YOCO_SECRET_KEY=sk_test_xxxxxxxx                  # use sk_test_ until you go live
YOCO_WEBHOOK_SECRET=whsec_xxxxxxxx                # signing secret from the webhook you register

# ---- URLs ----
PUBLIC_SITE_URL=https://skydive.bigwater.aero     # where booking.html is hosted (no trailing slash)
ALLOWED_ORIGIN=https://skydive.bigwater.aero      # CORS origin for the booking page (or * while testing)

# ---- Cron protection (optional) ----
CRON_SECRET=some-long-random-string
